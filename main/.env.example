# Copy to .env.local and fill in. Never commit .env.local or .env.production.
#
# On the deployed Worker these do not come from a file. The public ones live in wrangler.toml
# under [vars], and the secret ones are set with `wrangler secret put <NAME>`. This file only
# describes the shape so a new machine can get running.

# --- secret ---------------------------------------------------------------
# Local: the docker-compose Postgres, reached through the Neon HTTP proxy.
# Production: the Neon connection string, set as a Wrangler secret.
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/goodluck

# 32+ random bytes. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=

# Guards the scheduled job endpoint so only the cron trigger can call it.
CRON_SECRET=

# Salt for hashing visitor IPs. Changing it breaks rate limiting against existing rows.
IP_HASH_SALT=

# --- public ---------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
RESEND_FROM_EMAIL=
TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_MAPS_API_KEY=
