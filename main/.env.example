# Copy to .env.local for development. Production values live in the hosting project's
# environment settings, not in a file. Every variable below is read somewhere in the code.

# Local Postgres from docker-compose, through the Neon HTTP proxy. Production is Neon itself.
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/goodluck

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Both must be the site's own origin. Better Auth reads them from the environment by name.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Media library. The cloud name is public because it sits in every delivery URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email. The from address must be on a domain verified with Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudflare's always-pass test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Guards the scheduled-publish route against anyone who finds the URL.
CRON_SECRET=

# Changing this breaks rate limiting against existing rows.
IP_HASH_SALT=

# Empty renders no tag. An admin can also set this in Settings, which wins over this value.
NEXT_PUBLIC_GTM_ID=

# Build only, and only locally: the Neon proxy in docker-compose takes far fewer connections
# than Neon, so 1 prerenders one page at a time. Leave unset in CI and in production.
BUILD_CPUS=
