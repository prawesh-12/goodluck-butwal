# Copy to .env.local and fill in. Never commit .env.local or .env.production.
#
# In production these do not come from a file. They are the project's environment variables in
# Vercel. This file only describes the shape so a new machine can get running.

# --- secret ---------------------------------------------------------------
# Local: the docker-compose Postgres, reached through the Neon HTTP proxy.
# Production: the Neon connection string, set in the Vercel project.
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/goodluck

# 32+ random bytes. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
# Cloudflare publishes test keys that always pass. Use them locally, never in production.
# Site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Guards the scheduled job endpoint so only the cron trigger can call it.
CRON_SECRET=

# Salt for hashing visitor IPs. Changing it breaks rate limiting against existing rows.
IP_HASH_SALT=

# --- public ---------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# A Sentry DSN is meant to be public, it is in every browser SDK, and the two error screens run
# in the browser. Set this one name and both the server and the browser report. Leave it empty
# and nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GTM_ID=
