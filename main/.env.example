# Copy to .env.local. In production these are the Vercel project's environment variables.

# Local Postgres from docker-compose, through the Neon HTTP proxy. Production is Neon itself.
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/goodluck

# openssl rand -base64 32
BETTER_AUTH_SECRET=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
# Cloudflare's always-pass test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

CRON_SECRET=

# Changing this breaks rate limiting against existing rows.
IP_HASH_SALT=

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public on purpose. Empty sends nothing.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GTM_ID=
